    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "^15.5.7",
    "postcss": "^8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5",
    "vitest": "^4.0.18"
